{
  "name": "spa-2026",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Single-circuit racing simulator of Spa-Francorchamps with a 2026-regulation open-wheel car",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "track:fetch": "bash tools/track/fetch_sources.sh",
    "track:build": "python3 -I tools/track/build_track.py"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
